# Redis Configuration for File Processing System
# Server: <%= @server_id %> (<%= @is_master ? 'MASTER' : 'REPLICA' %>)

# Network
bind 0.0.0.0
port <%= @fileprocessing::params::redis_port %>
protected-mode no

# General
daemonize no
supervised systemd
pidfile /var/run/redis/redis.pid
loglevel notice
logfile /var/log/redis/redis.log

# Snapshotting
save 900 1
save 300 10
save 60 10000
stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir /var/lib/redis

# Replication
<% unless @is_master %>
replicaof <%= @master_ip %> <%= @fileprocessing::params::redis_port %>
<% end %>
replica-serve-stale-data yes
replica-read-only yes
repl-diskless-sync no
repl-disable-tcp-nodelay no

# Security
requirepass <%= @redis_password['password'] %>
<% unless @is_master %>
masterauth <%= @redis_password['password'] %>
<% end %>

# Limits
maxclients 10000
maxmemory 2gb
maxmemory-policy allkeys-lru

# Append Only File
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# Slow Log
slowlog-log-slower-than 10000
slowlog-max-len 128

# Latency Monitor
latency-monitor-threshold 100
